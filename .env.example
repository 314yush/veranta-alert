# Telegram — create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=

# Veranta service credentials (Model A: service-owned only)
# 1) Open https://delegate.veranta.xyz/ and generate an API/delegate key
# 2) VERANTA_PRIVATE_KEY = that API key (shown once)
# 3) VERANTA_TRADER_ADDRESS = the operator wallet that authorized the key
# End users never paste keys — they only send a Base watch wallet (0x…).
VERANTA_PRIVATE_KEY=
VERANTA_TRADER_ADDRESS=
VERANTA_NETWORK=mainnet

# Dual cadence
HOT_POLL_SECONDS=15
IDLE_POLL_SECONDS=180

# Alert tuning (PnL% of collateral toward Veranta liq ≈ -85%)
PNL_ALERT_LEVELS=-40,-60,-75
LIQ_PNL_PERCENT=-85
ALERT_COOLDOWN_SECONDS=300
# PnL percentage-points that must recover above a level before it re-arms
HYSTERESIS_PERCENT=0.5

SQLITE_PATH=data/bot.db
LOG_LEVEL=INFO

# Mark price freshness (reject feed-v3 older than this)
# Primary mark = Veranta Lazer SSE; secondary = fresh feed-v3 only.
MARK_MAX_AGE_SECONDS=120

# Hosting: mount persistent volume at /data, set SQLITE_PATH=/data/bot.db
PORT=8080
